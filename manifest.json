{
  "manifest_version": 3,
  "name": "Marketplace Detour Router",
  "version": "0.0.1",
  "description": "Reroutes Facebook Marketplace browsing through alternate paths.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marketplace Detour Router"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "https://api.mapbox.com/*"
  ],
  "permissions": ["storage", "geolocation"]
}
