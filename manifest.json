{
  "manifest_version": 3,
  "name": "Marketplace Detour Router",
  "version": "0.0.1",
  "description": "Reroutes Facebook Marketplace browsing through alternate paths.",
  "action": {
    "default_title": "Marketplace Detour Router"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["geo-override.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": [
        "content.js",
        "feed-scraper.js",
        "location-modal.js",
        "worker.js",
        "sidebar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "https://api.mapbox.com/*"
  ],
  "permissions": ["storage", "geolocation", "sidePanel"]
}
